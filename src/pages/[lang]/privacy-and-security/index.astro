---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { useTranslations, useList, useEntries, LOCALES, localePath, type Locale } from '../../../i18n';
import { links } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const list = useList(lang);
const entries = useEntries(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${localePath(lang, path)}`;
---
<Base lang={lang} route="security">
  <PageHead eyebrow={t('page.security.eyebrow')} title={t('page.security.title')} lede={t('security.lede')} />

  <div class="callout">
    <h3>{t('security.report.h3')}</h3>
    <p>{t('security.report.p1')}</p>
    <ul class="list-plain">
      <li><a href={links.advisories} rel="noopener noreferrer">{t('security.report.advisories')}</a></li>
      <li><a href={links.securityContact}>{t('security.report.email')}</a></li>
    </ul>
    <p>{t('security.report.pgp')}</p>
    <p><a href={links.security} rel="noopener noreferrer">{t('security.report.policyLink')}</a></p>
  </div>

  <section aria-labelledby="targets">
    <h2 id="targets">{t('security.targets.h2')}</h2>
    <p>{t('security.targets.intro')}</p>
    <div class="table-scroll">
      <table>
        <caption>{t('security.targets.caption')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('security.targets.col.stage')}</th>
            <th scope="col">{t('security.targets.col.target')}</th>
          </tr>
        </thead>
        <tbody>
          {entries('security.targets.rows').map((row) => (
            <tr>
              <th scope="row">{row.stage}</th>
              <td>{row.target}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{t('security.targets.caveat')}</p>
  </section>

  <section aria-labelledby="chain">
    <h2 id="chain">{t('security.chain.h2')}</h2>
    <p>{t('security.chain.intro')}</p>
    <ul>
      {list('security.chain.items').map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="gaps">
    <h2 id="gaps">{t('security.gaps.h2')}</h2>
    <p>{t('security.gaps.intro')}</p>
    <ul>
      {list('security.gaps.items').map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="sitedata">
    <h2 id="sitedata">{t('security.sitedata.h2')}</h2>
    <p>{t('security.sitedata.p1')}</p>
    <p>{t('security.sitedata.p2')}</p>
    <p><a href={href('legal/privacy')}>{t('security.sitedata.link')}</a></p>
  </section>

  <section aria-labelledby="secfaq">
    <h2 id="secfaq">{t('security.faq.h2')}</h2>
    <dl class="faq">
      {entries('security.faq.items').map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </>
      ))}
    </dl>
  </section>
</Base>
