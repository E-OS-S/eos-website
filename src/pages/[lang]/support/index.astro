---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import TicketForm from '../../../components/TicketForm.astro';
import { useTranslations, useList, useEntries, LOCALES, localePath, type Locale } from '../../../i18n';
import { support, links } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const list = useList(lang);
const entries = useEntries(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${localePath(lang, path)}`;

// The AI panel below states, in both languages, that the assistant is designed
// and not built. If somebody ever builds it, that text becomes a lie -- so the
// build refuses rather than letting the flag and the page disagree.
// See docs/ai-chat-design.md.
if (support.aiChat.built) {
  throw new Error(
    'support.aiChat.built is true, but the support page still says "designed, not built". ' +
      'Rewrite support.ai.* in src/i18n/*.json and remove this guard in the same change.',
  );
}
---
<Base lang={lang} route="support">
  <PageHead eyebrow={t('page.support.eyebrow')} title={t('page.support.title')} lede={t('support.lede')} />

  <div class="callout">
    <h3>{t('support.security.h3')}</h3>
    <p>{t('support.security.body')}</p>
    <p><a href={href('privacy-and-security')}>{t('support.security.link')}</a></p>
  </div>

  <section aria-labelledby="tickets">
    <h2 id="tickets">{t('support.tickets.h2')}</h2>
    <p>{t('support.tickets.p1')}</p>
    <p>{t('support.tickets.p2')}</p>
    <p class="meta">{t('support.tickets.project', { project: support.issuesProject })}</p>

    <TicketForm lang={lang} />

    <h3>{t('support.tickets.limits.h3')}</h3>
    <ul>
      {list('support.tickets.limits.items').map((item) => <li>{item}</li>)}
    </ul>
    <p>
      <a href={support.issuesListUrl} rel="noopener noreferrer">{t('support.tickets.browse')}</a>
    </p>
  </section>

  <section aria-labelledby="aichat">
    <h2 id="aichat">{t('support.ai.h2')}</h2>
    <div class="callout">
      <h3>{t('support.ai.badge')}</h3>
      <p>{t('support.ai.p1')}</p>
      <p>{t('support.ai.p2')}</p>
      <p>{t('support.ai.p3')}</p>
      <p class="meta">{t('support.ai.doc', { path: support.aiChat.designDoc })}</p>
    </div>
    <h3>{t('support.ai.what.h3')}</h3>
    <ul>
      {list('support.ai.what.items').map((item) => <li>{item}</li>)}
    </ul>
    <h3>{t('support.ai.not.h3')}</h3>
    <ul>
      {list('support.ai.not.items').map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="faq">
    <h2 id="faq">{t('support.faq.h2')}</h2>
    <dl class="faq">
      {entries('support.faq.items').map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="channels">
    <h2 id="channels">{t('support.channels.h2')}</h2>
    <p>{t('support.channels.intro')}</p>
    <ul class="list-plain">
      <li><a href={support.issuesListUrl} rel="noopener noreferrer">{t('support.channels.tickets')}</a></li>
      <li><a href={links.issues} rel="noopener noreferrer">{t('support.channels.upstreamIssues')}</a></li>
      <li><a href={links.advisories} rel="noopener noreferrer">{t('support.channels.advisories')}</a></li>
    </ul>
    <p>{t('support.channels.response')}</p>
  </section>
</Base>
